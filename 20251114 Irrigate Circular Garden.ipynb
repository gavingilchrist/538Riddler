   "source": [
    "import numpy as np\n",
    "\n",
    "ntrials = 10000000\n",
    "\n",
    "direction = np.random.random(ntrials) * np.pi\n",
    "cpt_x = np.sin(direction)\n",
    "cpt_y = np.cos(direction)\n",
    "mp_x = cpt_x / 2\n",
    "mp_y = (1+cpt_y) / 2\n",
    "\n",
    "dist_o_mp = np.sqrt(mp_x**2 + mp_y**2)\n",
    "\n",
    "np.mean(dist_o_mp)\n",
    "\n",
    "# ==~ 2 / pi"
   ]
  }
 ],
